{
  "name": "fundmatch-backend",
  "version": "1.0.0",
  "private": true,
  "description": "FundMatch AI backend core and database (Hritik)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'); fs.copyFileSync('src/db/schema.sql','dist/db/schema.sql'); fs.copyFileSync('src/db/seed.sql','dist/db/seed.sql');\"",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "migrate": "ts-node src/db/migrate.ts",
    "migrate:reset": "ts-node src/db/migrate.ts --reset",
    "db:local": "ts-node src/db/localServer.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "embedded-postgres": "^18.1.0-beta.16",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  }
}
